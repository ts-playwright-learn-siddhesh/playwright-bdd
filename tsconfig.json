{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "*": [
        "./*"
      ]
    }
  },
  "include": [
    "src/step-definitions/**/*.ts",
    "src/pages/**/*.ts",
    "src/support/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "reports",
    "test-results",
    "playwright-report"
  ]
}
